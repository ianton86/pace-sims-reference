cff-version: 1.2.0
message: >-
  If you use this software, please cite both the software (this record) and the
  paper it accompanies.
title: "PACE-SIMS: reference implementation of checkpoint-gated autonomous ToF-SIMS orchestration"
abstract: >-
  Reference implementation of the checkpoint-gated orchestration described in
  the accompanying paper: the execution state machine, quality-control criteria,
  decision framework, safety enforcement, experiment state schema, and a
  simulator that stands in for the instrument so the whole lifecycle runs with
  no hardware.
type: software
authors:
  - family-names: Ievlev
    given-names: Anton
    affiliation: Oak Ridge National Laboratory
    orcid: "https://orcid.org/0000-0003-3645-0508"
  - family-names: Hare
    given-names: Heather
    affiliation: University of Michigan
  - family-names: Li
    given-names: Yiyang
    affiliation: University of Michigan
  - family-names: Kalinin
    given-names: Sergei
    affiliation: University of Tennessee, Knoxville

# The SOFTWARE licence. The deposited measurement data in data/ is CC BY 4.0 and
# is licensed separately -- CFF has one license field, so the split is recorded in
# LICENSE / LICENSE-DATA rather than here.
license: MIT
# Copyright (c) 2026 UT-Battelle, LLC -- a COMMENT, because `copyright` is not a
# key in the CFF 1.2.0 schema and an unknown key makes GitHub reject the whole
# file, which costs the "Cite this repository" button rather than one line. The
# notice itself lives in LICENSE and LICENSE-DATA, which is where it binds.
repository-code: "https://github.com/ianton86/pace-sims-reference"
version: 1.0.0
date-released: 2026-08-12
# The CONCEPT DOI, which always resolves to the NEWEST archived version, so this
# line does not silently go stale the day a v1.1 is released. The version-specific
# DOI for the v1.0.0 record sits under `identifiers` below, because an availability
# statement should cite the exact snapshot its claims were checked against, and
# that one must NOT drift.
#
# Which of the two a reader ends up citing is NOT decided here: cffconvert takes
# the DOI for its APA and BibTeX output from `identifiers`, not from this field, so
# the rendered citation names the v1.0.0 snapshot and the concept DOI is what stays
# available for anyone wanting every version. That is the right way round for a
# deposit backing a paper -- but it is renderer behaviour, checked (cffconvert
# 2.0.0) rather than assumed, and swapping the two fields is how to reverse it.
doi: 10.5281/zenodo.21906850
identifiers:
  - type: doi
    value: 10.5281/zenodo.21906851
    description: >-
      Zenodo archive of the v1.0.0 release -- the immutable snapshot the paper's
      code-availability statement cites.
preferred-citation:
  type: article
  title: "PACE-SIMS: Checkpoint-Gated Autonomous SIMS Characterization with AI-Agent Quality Control"
  authors:
    - family-names: Ievlev
      given-names: Anton
    - family-names: Hare
      given-names: Heather
    - family-names: Li
      given-names: Yiyang
    - family-names: Kalinin
      given-names: Sergei
  # The arXiv PREPRINT, deliberately -- not Digital Discovery. The paper is
  # submitted there and not yet accepted, so naming the journal here would be a
  # claim this record cannot support, and it is exactly the kind of field that
  # stays wrong if the paper lands somewhere else. The preprint is also the version
  # a reader can actually fetch today. On acceptance, swap these three for the
  # journal's DOI/name/year.
  doi: 10.48550/arXiv.2608.12277
  journal: arXiv
  year: 2026
